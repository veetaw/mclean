<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for every Mac App Store submission. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- User-selected files/folders only (a scan root the user explicitly
	     picks via NSOpenPanel), matching Capabilities.canAccessOtherUsersFiles
	     == false / canRunShredder == false for this flavor: no ambient
	     filesystem access outside what the user grants. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>

	<!-- Outbound only, for VirusTotalClient's hash-check lookups
	     (Capabilities.canUseVirusTotalHashCheck == true in both flavors).
	     Deliberately NOT com.apple.security.network.server: a sandboxed app
	     cannot run RemoteControlServer's LAN listener the way the Developer
	     ID build does — see Capabilities.canRunRemoteControlServer. -->
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
